{
  "mcpServers": {
    "codegraph": {
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "docker-hub": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "HUB_PAT_TOKEN",
        "mcp/dockerhub",
        "--transport=stdio",
        "--username=nicholaswilde"
      ],
      "trust": true
    },
    "serena": {
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context=antigravity",
        "--project-from-cwd"
      ],
      "trust": true
    },
    "headroom": {
      "command": "/home/nicholas/.local/bin/headroom",
      "args": [
        "mcp",
        "serve"
      ],
      "trust": true
    }
  }
}

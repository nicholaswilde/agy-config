# ==============================================================================
# Mailrise & Notification Configuration
# Copy this file to .env and adjust variables as needed.
# .env is ignored by git to protect credentials and local overrides.
# ==============================================================================

# Mailrise SMTP Endpoint
MAILRISE_URL=smtp://smtp.l.nicholaswilde.io:8025

# Mailrise target channel / recipient (configured in mailrise.yaml)
MAILRISE_TO=all@mailrise.xyz

# Sender email address
MAILRISE_FROM=agy-config@homelab.local

# Optional SMTP Authentication (if configured in Mailrise)
MAILRISE_USER=
MAILRISE_PASSWORD=

# Notification trigger mode:
# - both: notify on uncommitted/dirty changes and when synced/clean again
# - dirty: notify only when uncommitted/dirty changes detected (default)
# - disabled: disable notifications completely
NOTIFY_MODE=dirty

# Path filtering:
# When true, alerts on ANY uncommitted file in repo.
# When false, only alerts if skills, rules, settings, or configs are uncommitted.
CHECK_ALL_FILES=false

# Regex pattern for targeted file changes when CHECK_ALL_FILES=false
TARGET_REGEX="skills/|rules/|settings\.json|config\.json|mcp_config\.json"

# State file location for tracking whether notification was sent
# Defaults to $XDG_STATE_HOME/agy-config/dirty.state
# STATE_FILE=~/.local/state/agy-config/dirty.state

# ==========================================
# Antigravity CLI .gitignore
# ==========================================

# 1. State, History, and Memory Runtime
tmp/
history/
memory/
**/context-mode/
**/antigravity-cli/*
!**/antigravity-cli/settings.json

.codegraph/
.serena/

# 2. Logs, Caches, and Crash Dumps
log/
cache/
crashes/
*.log

# 3. Binaries and Updates
bin/

# 4. Dependencies and Build Artifacts
**/node_modules/
**/dist/
**/__pycache__/
**/*.pyc
**/*.pyo
**/config/plugins/
**/config/projects/
**/config/import_manifest.json
**/config/.migrated

# 5. Secrets (Ensure SOPS handles these)
secrets.yaml
secrets.yml
.env
*oauth-token*
*-token
